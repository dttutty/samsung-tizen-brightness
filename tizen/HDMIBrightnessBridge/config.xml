<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://m70bprobe.local/hdmi-bridge"
        version="2.2.8"
        viewmodes="maximized">
    <tizen:application id="q8YFGkFK1p.M70BProbe" package="q8YFGkFK1p" required_version="2.3"/>
    <content src="index.html"/>
    <access origin="*" subdomains="true"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <feature name="http://tizen.org/feature/tv.pip"/>
    <icon src="icon.png"/>
    <name>Samsung Tizen Brightness Bridge</name>
    <tizen:profile name="tv"/>
    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"
                   hwkey-event="enable"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/devel.api.version" value="6.5"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.audio"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/avinfo.color"/>
</widget>
